<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    A light navigation bar only exists from API 27. Asking for it in the base theme is a lint error
    at minSdk 26, and the attribute is simply ignored on 26 — so it lives here, where it applies.
  -->
  <style name="Theme.Discovery" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/window</item>
    <item name="android:statusBarColor">@color/window</item>
    <item name="android:navigationBarColor">@color/window</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
