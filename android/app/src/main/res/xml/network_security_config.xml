<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone: the app opens only its own https origin (appassets.androidplatform.net, served from the APK)
  and talks to the music services over https through the native bridge. No plain-http traffic is needed.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
